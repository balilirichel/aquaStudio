{
  "expo": {
    "name": "Aquascape Studio",
    "slug": "aquascape-studio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/aqualogo/ios/iTunesArtwork@2x.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a1414",
        "foregroundImage": "./assets/aqualogo/android/mipmap-xxxhdpi/ic_launcher_foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/aqualogo/android/ic_launcher-web.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store"
    ]
  }
}
